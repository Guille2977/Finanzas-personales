# Plantilla de secretos de la Edge Function telegram-webhook. SIN valores reales.
# Uso: cp supabase/secretos.env.ejemplo supabase/.env  → completar →
#      npx supabase secrets set --env-file supabase/.env --remote=<ref>
# supabase/.env está en .gitignore: nunca se sube.
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase solo (no se cargan).

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Debe ser EXACTAMENTE el secret_token registrado en setWebhook; si cambia, hay que volver a registrar el webhook.
TELEGRAM_SECRETO=
# Opcionales
GEMINI_KEY=
GEMINI_MODELO=gemini-flash-lite-latest
